import pandas as pd
 
# ============================================================
# 配置区
# ============================================================
BASE_TEMP = 15.5
MIN_HOURS_PER_DAY = 18
 
BRADFORD_INPUT = 'bradford_hourly_temp_2022_2025_FINAL.csv'
BRAMHAM_INPUT = 'bramham_hourly_temp_2022_2025_FINAL.csv'
OUTPUT_PATH = 'daily_hdd.csv'
 
 
# ============================================================
# 核心函数
# ============================================================
def compute_daily_hdd(filepath, station_label, base_temp=BASE_TEMP, min_hours=MIN_HOURS_PER_DAY):
    """
    从单个站点的逐小时气温文件, 计算逐日平均气温和HDD。
 
    参数
    ----
    filepath : str
        逐小时气温CSV文件路径, 需含datetime和air_temp_C两列
    station_label : str
        站点标签, 用于命名输出列(如'bradford')
    base_temp : float
        HDD计算的基准温度, 默认15.5°C
    min_hours : int
        每日最低有效小时数要求, 默认18
 
    返回
    ----
    DataFrame, 含date, daily_mean_temp_{station}, n_hours_valid_{station}, hdd_{station}
    """
    df = pd.read_csv(filepath)
    df['datetime'] = pd.to_datetime(df['datetime'])
    df['date'] = df['datetime'].dt.normalize()
 
    daily = df.groupby('date')['air_temp_C'].agg(['mean', 'count']).reset_index()
    daily.columns = ['date', f'daily_mean_temp_{station_label}', f'n_hours_valid_{station_label}']
 
    daily = daily[daily[f'n_hours_valid_{station_label}'] >= min_hours].copy()
    daily[f'hdd_{station_label}'] = (base_temp - daily[f'daily_mean_temp_{station_label}']).clip(lower=0)
 
    return daily
 
 
# ============================================================
# 主流程
# ============================================================
def main():
    print("Computing HDD from Bradford temperature data...")
    hdd_bradford = compute_daily_hdd(BRADFORD_INPUT, 'bradford')
    print(f"  {len(hdd_bradford)} valid days")
 
    print("Computing HDD from Bramham temperature data...")
    hdd_bramham = compute_daily_hdd(BRAMHAM_INPUT, 'bramham')
    print(f"  {len(hdd_bramham)} valid days")
 
    daily_hdd = hdd_bradford.merge(hdd_bramham, on='date', how='outer').sort_values('date')
 
    daily_hdd.to_csv(OUTPUT_PATH, index=False)
    print(f"\nSaved: {OUTPUT_PATH}")
    print(f"Total days: {len(daily_hdd)}")
    print(f"Date range: {daily_hdd['date'].min()} to {daily_hdd['date'].max()}")
 
 
if __name__ == '__main__':
    main()
 